# Example Environment Variables for Railway Deployment
# Copy these to your Railway project's environment variables

# REQUIRED: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here

# REQUIRED: Must be False in production
DEBUG=False

# REQUIRED: Add your Railway domain (update after deployment)
ALLOWED_HOSTS=.railway.app

# REQUIRED: Add your Railway URL (update after deployment)
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# AUTOMATIC: Railway sets this automatically when you add PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:port/dbname
